# Render placeholders before installation on the public FRP server.
# __APP_DOMAIN__ is the stable production hostname (recommended:
# yingge.example.com). The certificate must be publicly trusted and
# contain that hostname. Never use this template with a self-signed certificate.

map $http_upgrade $yingge_connection_upgrade {
    default upgrade;
    ''      '';
}

server {
    listen 80;
    listen [::]:80;
    server_name __APP_DOMAIN__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/yingge-acme;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __APP_DOMAIN__;

    ssl_certificate     __DOMAIN_CERT_FULLCHAIN__;
    ssl_certificate_key __DOMAIN_CERT_PRIVATE_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:__FRP_PROD_REMOTE_PORT__;
        include /etc/nginx/snippets/yingge-mcp-proxy.conf;
    }
}

server {
    listen __UAT_HTTPS_PORT__ ssl http2;
    listen [::]:__UAT_HTTPS_PORT__ ssl http2;
    server_name __UAT_DOMAIN__;

    ssl_certificate     __DOMAIN_CERT_FULLCHAIN__;
    ssl_certificate_key __DOMAIN_CERT_PRIVATE_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:__FRP_UAT_REMOTE_PORT__;
        include /etc/nginx/snippets/yingge-mcp-proxy.conf;
    }
}
